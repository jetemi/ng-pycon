# Database Configuration
# In Docker Compose, DB_HOST must be the Postgres service name ("db"), not localhost.
# DB_NAME / DB_USER / DB_PASSWORD must match what the db service uses (same values here).
DB_NAME=your_db
DB_USER=your_user
DB_PASSWORD=your_password
DB_HOST=db
DB_PORT=5432

# Django Configuration
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
# Include web.localhost when using Traefik with WEB_SUBDOMAIN=web and BASE_DOMAIN=localhost
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web.localhost

# Environment
DJANGO_SETTINGS_MODULE=pyconng.settings.dev
# Secret URL prefix for Wagtail/Django admin panels.
# In production, set to something hard to guess (e.g. "manage-8f3a2b").
# Admin will be at /<ADMIN_URL_PREFIX>/ and Django admin at /<ADMIN_URL_PREFIX>-djadmin/
ADMIN_URL_PREFIX=admin

# Traefik / Domain Configuration
BASE_DOMAIN=localhost
WEB_SUBDOMAIN=web
# Docker network your *external* Traefik container is on (required for routing).
# Find it: docker inspect <traefik_container_name> --format '{{json .NetworkSettings.Networks}}' | jq
# Then attach Traefik to this project: docker network connect ${TRAEFIK_NETWORK} <traefik_container>
# (only if Traefik is not already on that network)
TRAEFIK_NETWORK=your_traefik_network_name
# Entrypoint name in your Traefik static config (often "web" or "http" for :80)
TRAEFIK_ENTRYPOINT=web

# PgBouncer connection (used by web / web-prod to reach the remote database via Tailscale).
# These override the local DB_* values so Django talks to pgbouncer instead of the local Postgres.
PGBOUNCER_HOST=host.docker.internal
PGBOUNCER_PORT=6432
PGBOUNCER_DB_NAME=dolomo
PGBOUNCER_DB_USER=ulesia
PGBOUNCER_DB_PASSWORD=changeme

# Docker image for web-prod service.
# Local dev: use the locally built image name (e.g. ng-pycon-web:latest)
# Production: use the GitLab registry image (e.g. registry.gitlab.com/tuteria/v2/tutor-frontend-app/ng-pycon-web:latest)
WEB_IMAGE=ng-pycon-web:latest

# Resend (transactional email) — get key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxx
USE_RESEND_IN_DEV=False
